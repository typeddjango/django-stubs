import datetime
from collections.abc import AsyncIterator, Collection, Iterable, Iterator, Mapping, Sequence
from typing import Any, Generic, Literal, Never, Protocol, Self, final, overload, type_check_only

from django.core.checks.messages import CheckMessage
from django.db.models.base import Model
from django.db.models.expressions import Combinable, OrderBy
from django.db.models.query import Prefetch, QuerySet, RawQuerySet, _LookupT_co, _PrefetchedQuerySetT_co, _ToAttrT_co
from typing_extensions import TypeVar, deprecated

_T_co = TypeVar("_T_co", bound=Model, covariant=True)
_M = TypeVar("_M", bound=Model)
# We could technically use `bound=QuerySet[Model]` but this currently trip pyrefly for very little value
_QS_co = TypeVar("_QS_co", bound=QuerySet[Any], covariant=True, default=QuerySet[_T_co])

@final
@type_check_only
class _ManagerIsNotAccessibleViaInstances:
    """Managers are only reachable from the model class, e.g. `MyModel.objects` rather than `my_model.objects`."""

# `_T_co` is covariant, so `self: BaseManager[_M]` would let `_M` widen to a union of models. This binds it exactly.
@type_check_only
class _HasModel(Protocol[_M]):
    model: type[_M]

class BaseManager(Generic[_T_co, _QS_co]):
    creation_counter: int
    auto_created: bool
    use_in_migrations: bool
    name: str
    model: type[_T_co]
    _db: str | None
    def __new__(cls, *args: Any, **kwargs: Any) -> Self: ...
    def __init__(self) -> None: ...
    def __class_getitem__(cls, *args: Any, **kwargs: Any) -> type[Self]: ...
    def deconstruct(
        self,
    ) -> tuple[bool, str | None, str | None, Sequence[Any] | None, dict[str, Any] | None]: ...
    def check(self, **kwargs: Any) -> list[CheckMessage]: ...
    @classmethod
    def from_queryset(cls, queryset_class: type[QuerySet[_T_co]], class_name: str | None = None) -> type[Self]: ...
    @classmethod
    def _get_queryset_methods(cls, queryset_class: type) -> dict[str, Any]: ...
    def contribute_to_class(self, cls: type[Model], name: str) -> None: ...
    def db_manager(self, using: str | None = None, hints: dict[str, Model] | None = None) -> Self: ...
    @property
    def db(self) -> str: ...
    def get_queryset(self) -> _QS_co: ...
    def all(self) -> _QS_co: ...
    # Mirrors `ManagerDescriptor`: a manager is unreachable from an instance of its own model, but stays reachable
    # from anything else (plain classes, protocols, other models' instances). An unparametrized manager solves `_M`
    # to `Any`, so the `None` overload keeps class access reachable and `cls: type[Model]` plain-class access.
    @overload
    def __get__(self, instance: None, cls: type[Any] | None = None) -> Self: ...
    @overload
    @deprecated("Manager isn't accessible via model instances")
    def __get__(self: _HasModel[_M], instance: _M, cls: type[Model]) -> _ManagerIsNotAccessibleViaInstances: ...
    @overload
    def __get__(self, instance: object, cls: type[Any] | None = None) -> Self: ...

class Manager(BaseManager[_T_co, _QS_co]):
    _queryset_class: type[QuerySet[Any, Any]]
    # NOTE: The following methods are in common with QuerySet. Methods that proxy to `get_queryset()` and
    # preserve its type return `_QS_co`; methods building a differently-typed queryset (e.g. `values`,
    # `datetimes`, `extra`) return a plain `QuerySet` instead.
    def iterator(self, chunk_size: int | None = ...) -> Iterator[_T_co]: ...
    def aiterator(self, chunk_size: int = ...) -> AsyncIterator[_T_co]: ...
    def aggregate(self, *args: Any, **kwargs: Any) -> dict[str, Any]: ...
    async def aaggregate(self, *args: Any, **kwargs: Any) -> dict[str, Any]: ...
    def get(self, *args: Any, **kwargs: Any) -> _T_co: ...
    async def aget(self, *args: Any, **kwargs: Any) -> _T_co: ...
    def create(self, **kwargs: Any) -> _T_co: ...
    async def acreate(self, **kwargs: Any) -> _T_co: ...
    def bulk_create(
        self,
        objs: Iterable[_T_co],
        batch_size: int | None = ...,
        ignore_conflicts: bool = ...,
        update_conflicts: bool = ...,
        update_fields: Collection[str] | None = ...,
        unique_fields: Collection[str] | None = ...,
    ) -> list[_T_co]: ...
    async def abulk_create(
        self,
        objs: Iterable[_T_co],
        batch_size: int | None = ...,
        ignore_conflicts: bool = ...,
        update_conflicts: bool = ...,
        update_fields: Collection[str] | None = ...,
        unique_fields: Collection[str] | None = ...,
    ) -> list[_T_co]: ...
    def bulk_update(self, objs: Iterable[_T_co], fields: Iterable[str], batch_size: int | None = ...) -> int: ...
    async def abulk_update(self, objs: Iterable[_T_co], fields: Iterable[str], batch_size: int | None = ...) -> int: ...
    def get_or_create(self, defaults: Mapping[str, Any] | None = ..., **kwargs: Any) -> tuple[_T_co, bool]: ...
    async def aget_or_create(self, defaults: Mapping[str, Any] | None = ..., **kwargs: Any) -> tuple[_T_co, bool]: ...
    def update_or_create(
        self,
        defaults: Mapping[str, Any] | None = ...,
        create_defaults: Mapping[str, Any] | None = ...,
        **kwargs: Any,
    ) -> tuple[_T_co, bool]: ...
    async def aupdate_or_create(
        self,
        defaults: Mapping[str, Any] | None = ...,
        create_defaults: Mapping[str, Any] | None = ...,
        **kwargs: Any,
    ) -> tuple[_T_co, bool]: ...
    def earliest(self, *fields: str | OrderBy) -> _T_co: ...
    async def aearliest(self, *fields: str | OrderBy) -> _T_co: ...
    def latest(self, *fields: str | OrderBy) -> _T_co: ...
    async def alatest(self, *fields: str | OrderBy) -> _T_co: ...
    def first(self) -> _T_co | None: ...
    async def afirst(self) -> _T_co | None: ...
    def last(self) -> _T_co | None: ...
    async def alast(self) -> _T_co | None: ...
    def in_bulk(self, id_list: Iterable[Any] | None = ..., *, field_name: str = ...) -> dict[Any, _T_co]: ...
    async def ain_bulk(self, id_list: Iterable[Any] | None = ..., *, field_name: str = ...) -> dict[Any, _T_co]: ...
    def update(self, **kwargs: Any) -> int: ...
    async def aupdate(self, **kwargs: Any) -> int: ...
    def exists(self) -> bool: ...
    async def aexists(self) -> bool: ...
    def explain(self, *, format: str | None = ..., **options: Any) -> str: ...
    async def aexplain(self, *, format: str | None = ..., **options: Any) -> str: ...
    def contains(self, obj: Model) -> bool: ...
    async def acontains(self, obj: Model) -> bool: ...
    def raw(
        self,
        raw_query: str,
        params: Any = ...,
        translations: dict[str, str] | None = ...,
        using: str | None = ...,
    ) -> RawQuerySet[_T_co]: ...
    # The type of values may be overridden to be more specific in the mypy plugin, depending on the fields param
    def values(self, *fields: str | Combinable, **expressions: Any) -> QuerySet[_T_co, dict[str, Any]]: ...
    # The type of values_list may be overridden to be more specific in the mypy plugin, depending on the fields param
    def values_list(self, *fields: str | Combinable, flat: bool = ..., named: bool = ...) -> QuerySet[_T_co, Any]: ...
    def dates(
        self,
        field_name: str,
        kind: Literal["year", "month", "week", "day"],
        order: Literal["ASC", "DESC"] = "ASC",
    ) -> QuerySet[_T_co, datetime.date]: ...
    def datetimes(
        self,
        field_name: str,
        kind: Literal["year", "month", "week", "day", "hour", "minute", "second"],
        order: Literal["ASC", "DESC"] = "ASC",
        tzinfo: datetime.tzinfo | None = None,
    ) -> QuerySet[_T_co, datetime.datetime]: ...
    def none(self) -> _QS_co: ...
    def filter(self, *args: Any, **kwargs: Any) -> _QS_co: ...
    def exclude(self, *args: Any, **kwargs: Any) -> _QS_co: ...
    def complex_filter(self, filter_obj: Any) -> _QS_co: ...
    def count(self) -> int: ...
    async def acount(self) -> int: ...
    def union(self, *other_qs: QuerySet[Model, Any], all: bool = ...) -> _QS_co: ...
    def intersection(self, *other_qs: QuerySet[Model, Any]) -> _QS_co: ...
    def difference(self, *other_qs: QuerySet[Model, Any]) -> _QS_co: ...
    def select_for_update(
        self, nowait: bool = ..., skip_locked: bool = ..., of: Sequence[str] = ..., no_key: bool = ...
    ) -> _QS_co: ...
    @overload
    def select_related(self, clear: None, /) -> _QS_co: ...
    @overload
    def select_related(self, *fields: str) -> _QS_co: ...
    @overload
    def prefetch_related(self, clear: None, /) -> _QS_co: ...
    @overload
    def prefetch_related(
        self, *lookups: str | Prefetch[_LookupT_co, _PrefetchedQuerySetT_co, _ToAttrT_co]
    ) -> _QS_co: ...
    def annotate(self, *args: Any, **kwargs: Any) -> _QS_co: ...
    def alias(self, *args: Any, **kwargs: Any) -> _QS_co: ...
    def order_by(self, *field_names: str | Combinable) -> _QS_co: ...
    def distinct(self, *field_names: str) -> _QS_co: ...
    # extra() return type won't be supported any time soon
    def extra(
        self,
        select: dict[str, Any] | None = ...,
        where: list[str] | None = ...,
        params: list[Any] | None = ...,
        tables: list[str] | None = ...,
        order_by: Sequence[str] | None = ...,
        select_params: Sequence[Any] | None = ...,
    ) -> QuerySet[Any]: ...
    def reverse(self) -> _QS_co: ...
    @overload
    def defer(self, clear: None, /) -> _QS_co: ...
    @overload
    def defer(self, *fields: str) -> _QS_co: ...
    def only(self, *fields: str) -> _QS_co: ...
    def using(self, alias: str | None) -> _QS_co: ...

class ManagerDescriptor:
    manager: BaseManager[Any]
    def __init__(self, manager: BaseManager[Any]) -> None: ...
    @overload
    def __get__(self, instance: None, cls: type[Model] | None = None) -> BaseManager[Any]: ...
    @overload
    def __get__(self, instance: Model, cls: type[Model] | None = None) -> Never: ...

class EmptyManager(Manager[_T_co, _QS_co]):
    def __init__(self, model: type[_T_co]) -> None: ...
