class RawQuerySet(_SupportsContains[object], Iterable[_Model_co], Sized):
    raw_query: RawQuery | str
    model: type[_Model_co] | None
    query: RawQuery
    params: tuple[Any, ...] | None
    translations: dict[str, str]

    def __init__(
        self,
        raw_query: RawQuery | str,
        model: type[_Model_co] | None = None,
        query: Query | None = None,
        params: tuple[Any, ...] = (),
        translations: dict[str, str] | None = None,
        using: str | None = None,
        hints: dict[str, Model] | None = None,
        fetch_mode: FetchMode = ...,
    ) -> None: ...
    def resolve_model_init_order(self) -> tuple[list[str], list[int], list[tuple[str, int]]]: ...
    @overload
    def prefetch_related(self, clear: None, /) -> Self: ...
    @overload
    def prefetch_related(self, *lookups: str | Prefetch[_LookupT_co, _PrefetchedQuerySetT_co, _ToAttrT_co]) -> Self: ...
    @override
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    @override
    def __iter__(self) -> Iterator[_Model_co]: ...
    def __aiter__(self) -> AsyncIterator[_Model_co]: ...
    def iterator(self) -> Iterator[_Model_co]: ...
    @overload
    def __getitem__(self, k: int) -> _Model_co: ...
    @overload
    def __getitem__(self, k: str) -> Any: ...
    @overload
    def __getitem__(self, k: slice) -> Self: ...
    @property
    def db(self) -> str: ...
    def using(self, alias: str | None) -> Self: ...
    @cached_property
    def columns(self) -> list[str]: ...
    @cached_property
    def model_fields(self) -> dict[str, str]: ...

