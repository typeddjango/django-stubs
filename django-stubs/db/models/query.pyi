from django.utils.functional import cached_property
from typing_extensions import TypeVar, override

_T_co = TypeVar("_T_co", covariant=True)
_ContainsT = TypeVar("_ContainsT")
_Model_co = TypeVar("_Model_co", bound=Model, covariant=True)
_Row_co = TypeVar("_Row_co", covariant=True, default=_Model_co)  # ONLY use together with _Model_co
_TupleT_co = TypeVar("_TupleT_co", bound=tuple[Any, ...], covariant=True)

# The type of the lookup passed to Prefetch(...)
# This will be specialized to a `LiteralString` in the plugin for further processing and validation
_LookupT_co = TypeVar("_LookupT_co", bound=str, covariant=True)
# The type of the queryset passed to Prefetch(...)
_PrefetchedQuerySetT_co = TypeVar(
    "_PrefetchedQuerySetT_co", bound=QuerySet[Model], covariant=True, default=QuerySet[Model]
)
# The attribute name to store the prefetched list[_PrefetchedQuerySetT_co]
# This will be specialized to a `LiteralString` in the plugin for further processing and validation
_ToAttrT_co = TypeVar("_ToAttrT_co", bound=str, covariant=True, default=str)

_OrderByFieldName: TypeAlias = str | Combinable

MAX_GET_RESULTS: int
REPR_OUTPUT_SIZE: int
DEFAULT_FETCH_MODE: FetchMode
PROHIBITED_FILTER_KWARGS: frozenset[str]

class BaseIterable(Generic[_T_co]):
    queryset: QuerySet[Model]
    chunked_fetch: bool
    chunk_size: int
    def __init__(self, queryset: QuerySet[Model], chunked_fetch: bool = False, chunk_size: int = 100) -> None: ...
    def __aiter__(self) -> AsyncIterator[_T_co]: ...

class ModelIterable(BaseIterable[_Model_co], Generic[_Model_co]):
    def __iter__(self) -> Iterator[_Model_co]: ...

class RawModelIterable(BaseIterable[dict[str, Any]]):
    def __iter__(self) -> Iterator[dict[str, Any]]: ...

class ValuesIterable(BaseIterable[dict[str, Any]]):
    def __iter__(self) -> Iterator[dict[str, Any]]: ...

class ValuesListIterable(BaseIterable[_TupleT_co]):
    def __iter__(self) -> Iterator[_TupleT_co]: ...

class NamedValuesListIterable(ValuesListIterable[NamedTuple]):
    @override
    def __iter__(self) -> Iterator[NamedTuple]: ...

class FlatValuesListIterable(BaseIterable[_T_co]):
    def __iter__(self) -> Iterator[_T_co]: ...

@type_check_only
class _SupportsContains(Generic[_ContainsT]):
    def __contains__(self, item: _ContainsT, /) -> bool: ...

class PreventQuerySetCloning:
    queryset: QuerySet[Any]
    def __init__(self, queryset: QuerySet[Any]) -> None: ...
    def __enter__(self) -> QuerySet[Any]: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

