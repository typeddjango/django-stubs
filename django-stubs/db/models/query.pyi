_QuerySet: TypeAlias = QuerySet  # ruff: ignore[unused-private-type-alias]

class Prefetch(Generic[_LookupT_co, _PrefetchedQuerySetT_co, _ToAttrT_co]):
    prefetch_through: str
    prefetch_to: str
    queryset: _PrefetchedQuerySetT_co | None
    to_attr: _ToAttrT_co | None
    def __init__(
        self, lookup: _LookupT_co, queryset: _PrefetchedQuerySetT_co | None = None, to_attr: _ToAttrT_co | None = None
    ) -> None: ...
    @override
    def __getstate__(self) -> dict[str, Any]: ...
    def add_prefix(self, prefix: str) -> None: ...
    def get_current_prefetch_to(self, level: int) -> str: ...
    def get_current_to_attr(self, level: int) -> tuple[str, str]: ...
    def get_current_querysets(self, level: int) -> Sequence[_PrefetchedQuerySetT_co] | None: ...

def normalize_prefetch_lookups(
    lookups: Sequence[str | Prefetch[Any]], prefix: str | None = None
) -> list[Prefetch[Any]]: ...
def prefetch_related_objects(model_instances: Sequence[_Model_co], *related_lookups: str | Prefetch[Any]) -> None: ...
async def aprefetch_related_objects(
    model_instances: Sequence[_Model_co], *related_lookups: str | Prefetch[Any]
) -> None: ...
def get_prefetcher(instance: Model, through_attr: str, to_attr: str) -> tuple[Any, Any, bool, bool]: ...
def prefetch_one_level(
    instances: Sequence[Model], prefetcher: Any, lookup: Prefetch[Any], level: int
) -> tuple[list[Any], list[Prefetch[Any]]]: ...

